{
  "id": "text-editor",
  "name": "Editor de texto",
  "description": "Crea y edita documentos de texto plano y Markdown.",
  "version": "1.0.0",
  "author": "",
  "icon": "icon.svg",
  "category": "productividad",
  "launchpad": {
    "visible": true,
    "order": 20
  },
  "dock": {
    "pinnedByDefault": true
  },
  "window": {
    "width": 760,
    "height": 520,
    "minWidth": 380,
    "minHeight": 260,
    "resizable": true,
    "singleInstance": false
  },
  "fileAssociations": [
    {
      "extensions": [
        "txt",
        "md"
      ],
      "role": "editor",
      "priority": 10
    }
  ],
  "permissions": []
}
