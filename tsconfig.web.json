{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@os/sdk": ["./src/renderer/src/os/sdk/index.ts"],
      "@os/ui": ["./src/renderer/src/os/ui/index.ts"],
      "@system/*": ["./src/renderer/src/system/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*"]
}
